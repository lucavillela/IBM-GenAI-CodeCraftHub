# CodeCraftHub settings.
# Copy this file to ".env" and change the values you need:
#
#     cp .env.example .env
#
# The ".env" file is private to your machine and is not committed to git.
# Every setting is optional: the values below are the defaults.

# Address the server listens on. 127.0.0.1 = only this computer.
# Use 0.0.0.0 to allow other devices on your network to connect.
HOST=127.0.0.1

# Port the server listens on. If 5000 is busy (on macOS, AirPlay Receiver
# uses it), pick another one, for example 5001.
PORT=5000

# true = auto-reload when you edit the code, and show detailed error pages.
# Set to false for anything other than local development.
DEBUG=true

# File where courses are saved. A relative path is placed next to app.py;
# an absolute path (e.g. /home/me/courses.json) is used as is.
DATA_FILE=courses.json

# Websites allowed to call the API from a browser (CORS).
# * = any website. Or a comma-separated list, e.g.
# CORS_ORIGINS=http://localhost:3000,https://mysite.com
CORS_ORIGINS=*

# Frontend: the address the dashboard page uses to reach the API.
# Leave empty when the dashboard is opened through this server
# (http://127.0.0.1:PORT/); it then follows HOST and PORT automatically.
# Set it only if the API is reachable at a different address, e.g.
# BACKEND_URL=https://api.example.com
BACKEND_URL=
